# Browser-visible build switch. Leave false until form registration and policies are checked.
PUBLIC_FORMS_ENABLED=false

# Server-only variables: set securely in Netlify Functions scope, never PUBLIC_ or VITE_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_TO_EMAIL=dave@theledjs.ie
# disabled | test | production. Production also requires CONTEXT=production at runtime.
EMAIL_DELIVERY_MODE=disabled
RESEND_TEST_RECIPIENT=

# Netlify supplies the build context. For local production-output checks only:
# CONTEXT=production
