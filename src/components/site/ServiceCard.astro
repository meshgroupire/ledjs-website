---
const { service } = Astro.props;
---
<article class="service"><a class="service-image" href={`/services/${service.slug}`} tabindex="-1" aria-hidden="true"><img src={service.image} alt="" width="640" height="480" loading="lazy" style={service.imageFit ? 'object-fit:contain;background:white;padding:30px' : ''} /></a><div><h3>{service.title}</h3><p>{service.shortDescription}</p><a class="text-link" href={`/services/${service.slug}`}>Explore {service.slug === 'wedding-dj' ? 'wedding entertainment' : service.title.toLowerCase()}</a></div></article>
