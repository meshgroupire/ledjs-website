---
import SiteLayout from '../layouts/SiteLayout.astro';
import Picture from '../components/site/Picture.astro';
import ServiceCard from '../components/site/ServiceCard.astro';
import { primaryServices } from '../content/services.mjs';
const weddingEnquiry = `/contact?occasion=Wedding&service=${encodeURIComponent(primaryServices[0].title)}`;
---
<SiteLayout title="Wedding DJs Longford & the Midlands | LEDJS" description="Full-evening wedding DJs and after-band sets from Longford. Plan your music with LEDJS and add optional LED wristbands. Enquire about your date.">
  <section class="hero" aria-labelledby="hero-title"><Picture class="hero-photo" name="wedding-djs" alt="A wedding crowd celebrating together on the dancefloor" priority /><div class="wrap hero-inner"><p class="hero-location">Wedding DJs. Full evening or after the band.<br />Longford, the Midlands and beyond.</p><h1 id="hero-title" class="wedding-headline">Your wedding.<br />Your kind<br />of night.</h1><p class="hero-copy">Your people. Your music. A dancefloor that feels like you. Plan the night with LEDJS, with optional LED wristbands for a moment everyone can be part of.</p><div class="hero-actions"><a href={weddingEnquiry} class="button">Check your wedding date</a><a href="/services/wedding-dj" class="button outline">Explore wedding DJs</a></div></div></section>
  <section class="quick-start" aria-label="Start an enquiry"><div class="wrap"><form action="/contact" method="get"><div class="quick-title"><h2>Got a date in mind?</h2><p>Let's talk about your celebration.</p></div><div><label for="quick-occasion">I'm planning a…</label><select name="occasion" id="quick-occasion"><option>Wedding</option><option>Private party</option><option>Corporate event</option><option>Fundraiser</option><option>Venue night</option></select></div><div><label for="quick-date">Event date (optional)</label><input type="date" name="date" id="quick-date" /></div><button class="button" type="submit">Start my enquiry</button></form></div></section>
  <section class="section"><div class="wrap"><div class="split-heading"><h2>Good people.<br />Great nights.</h2><p>From the first dance to your next big celebration. Find the DJ experience that brings your crowd together.</p></div><div class="services-grid">{primaryServices.map(service=><ServiceCard service={service} />)}</div><div class="service-options"><span>Get everyone involved</span><a href="/services/music-bingo">Songo Music Bingo</a><a href="/services/speed-quizzing">Speed quizzing</a><a href="/services/karaoke">Karaoke</a><a href="/services/led-wristbands">LED wristbands</a></div></div></section>
  <section><div class="wrap"><div class="experience"><Picture class="experience-photo" name="ledjs6" alt="An illuminated LEDJS wristband" /><div class="experience-copy"><h2>Your music first.<br />An extra moment<br />if you want it.</h2><p class="intro">Build the night around the music you love. Add synchronised LED wristbands if you want to bring your guests into the light show for a favourite track or finale.</p><a class="button dark" href="/services/wedding-dj">Plan your wedding entertainment</a><div class="quote"><p>Full evening or after the band?</p><p class="helper">We'll discuss the music, timing and setup that suit your wedding.</p></div></div></div><div class="local-note"><strong>Based in Longford. Built around your crowd.</strong><span>Weddings, private celebrations and corporate events.</span></div></div></section>
  <section class="section"><div class="wrap experience"><div class="songo-panel"><img src="/images/brands/songo-logo.png" width="275" height="63" alt="Songo" loading="lazy" /></div><div class="experience-copy"><h2>Songo Music Bingo.<br />Hosted by LEDJS.</h2><p class="intro">Your local Songo franchisee. Talk to Dave about a fundraiser, a staff event or a venue night.</p><a class="button dark" href="/services/music-bingo">Explore Songo Music Bingo</a></div></div></section>
  <section class="section faq-section"><div class="wrap enquiry"><div><h2>A great night<br />starts with<br />a hello.</h2><p class="intro">Tell Dave your date, venue and what you have in mind. Still working out the details? Start with what you know.</p></div><div class="contact-spot"><h3>Let's plan your event.</h3><p>Ask about availability and a tailored quote. An enquiry starts a conversation; it doesn't reserve your date.</p><a class="button" href="/contact">Start your enquiry</a><a class="text-link" href="/about">Meet Dave</a></div></div></section>
</SiteLayout>
